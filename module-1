<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Module 01 — Wat is AI eigenlijk?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;0,9..144,900;1,9..144,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#0D1117;--ink2:#1C2333;--muted:#6B7A99;--light:#F4F5F8;
  --border:#E4E7EF;--blue:#2D5BE3;--blue-light:#EEF2FD;
  --green:#059669;--red:#DC2626;--gold:#C8922A;
  --sidebar:240px;
}
html,body{height:100%;font-family:'DM Sans',sans-serif;background:#F8F9FB;color:var(--ink);overflow-x:hidden}

/* ── LAYOUT ── */
.shell{display:flex;min-height:100vh}

/* ── SIDEBAR ── */
.sidebar{
  width:var(--sidebar);flex-shrink:0;
  background:#fff;border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  position:sticky;top:0;height:100vh;overflow-y:auto;
}

.sidebar-head{
  padding:20px 18px 16px;
  border-bottom:1px solid var(--border);
}
.sidebar-back{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12px;color:var(--muted);text-decoration:none;
  margin-bottom:14px;
}
.sidebar-back:hover{color:var(--ink)}
.sidebar-back svg{width:12px;height:12px}
.sidebar-mod-label{font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.sidebar-mod-title{font-family:'Fraunces',serif;font-size:15px;font-weight:700;color:var(--ink);line-height:1.25}

.sidebar-nav{padding:12px 10px;flex:1}
.nav-group{margin-bottom:4px}
.nav-group-label{font-size:10px;font-weight:500;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:8px 8px 4px;display:block}

.nav-item{
  display:flex;align-items:center;gap:9px;
  padding:7px 8px;border-radius:7px;cursor:pointer;
  font-size:13px;color:var(--muted);
  transition:background .15s,color .15s;
  border:none;background:none;width:100%;text-align:left;
  line-height:1.3;
}
.nav-item:hover{background:var(--light);color:var(--ink)}
.nav-item.active{background:var(--blue-light);color:var(--blue);font-weight:500}
.nav-item.done{color:var(--ink)}
.nav-item.done .nav-check{opacity:1}

.nav-icon{
  width:24px;height:24px;border-radius:6px;
  background:var(--light);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;flex-shrink:0;color:var(--muted);
  transition:all .15s;
}
.nav-item.active .nav-icon{background:var(--blue);border-color:var(--blue);color:#fff}
.nav-item.done .nav-icon{background:#F0FDF4;border-color:#6EE7B7;color:var(--green)}

.nav-check{opacity:0;font-size:10px}

.sidebar-footer{
  padding:14px 18px;border-top:1px solid var(--border);
}
.progress-label{font-size:11px;color:var(--muted);margin-bottom:6px;display:flex;justify-content:space-between}
.progress-bar{height:4px;background:var(--light);border-radius:2px;overflow:hidden}
.progress-fill{height:100%;background:var(--blue);border-radius:2px;transition:width .4s}

/* ── MAIN ── */
.main{flex:1;display:flex;flex-direction:column;min-height:100vh}

.topbar{
  padding:14px 32px;border-bottom:1px solid var(--border);
  background:#fff;display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:10;
}
.topbar-title{font-size:14px;font-weight:500;color:var(--ink)}
.topbar-right{display:flex;align-items:center;gap:12px}
.step-indicator{font-size:12px;color:var(--muted)}

.content{flex:1;padding:40px 48px 64px;max-width:760px}

/* ── VIEW STATES ── */
.view{display:none}.view.active{display:block}

/* ── COMPONENTS ── */
.badge{display:inline-block;font-size:11px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;padding:3px 10px;border-radius:20px;background:var(--blue-light);color:var(--blue);margin-bottom:18px}

.h1{font-family:'Fraunces',serif;font-size:clamp(24px,3vw,36px);font-weight:700;line-height:1.15;letter-spacing:-.02em;color:var(--ink);margin-bottom:14px}
.body{font-size:15px;color:var(--muted);line-height:1.75;margin-bottom:16px}
.callout{border-left:2px solid var(--blue);padding:13px 18px;background:var(--blue-light);font-size:14px;font-style:italic;color:#1E3A8A;margin:16px 0 20px;line-height:1.65;border-radius:0 8px 8px 0}

/* VIDEO */
.video-section{margin-bottom:32px}
.video-label{font-size:11px;font-weight:500;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.video-container{
  aspect-ratio:16/9;background:var(--ink2);border-radius:12px;
  border:1px solid var(--border);overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  position:relative;
}
.video-container iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
.video-placeholder{
  display:flex;flex-direction:column;align-items:center;gap:10px;
  color:rgba(255,255,255,0.3);text-align:center;padding:20px;
}
.video-placeholder svg{width:40px;height:40px;opacity:.4}
.video-placeholder p{font-size:13px;line-height:1.5}
.video-placeholder code{font-size:11px;background:rgba(255,255,255,.08);padding:3px 8px;border-radius:4px;font-family:monospace}

/* TWO-COL */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
.col-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:16px 18px}
.col-card h4{font-size:13px;font-weight:500;color:var(--ink);margin-bottom:8px}
.col-card p{font-size:13px;color:var(--muted);line-height:1.6}

/* NAV BUTTONS */
.nav-row{display:flex;justify-content:space-between;align-items:center;margin-top:36px;padding-top:24px;border-top:1px solid var(--border)}
.dots{display:flex;gap:4px;align-items:center}
.dot{height:6px;border-radius:3px;background:var(--border);transition:all .2s}
.dot.cur{width:18px;background:var(--blue)}
.dot.past{width:6px;background:var(--blue)}
.dot.fut{width:6px}
.btn-p{background:var(--blue);color:#fff;border:none;padding:10px 22px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:opacity .15s}
.btn-p:hover{opacity:.88}
.btn-p:disabled{opacity:.4;cursor:default}
.btn-g{background:#fff;border:1px solid var(--border);color:var(--muted);padding:10px 22px;border-radius:8px;font-size:14px;cursor:pointer;font-family:'DM Sans',sans-serif}
.btn-g:hover{background:var(--light)}

/* OEFENING */
.oef-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:16px 0}
.oef-item{padding:12px 14px;border:1px solid var(--border);border-radius:8px;background:#fff;cursor:pointer;font-size:13px;color:var(--ink);text-align:center;transition:all .2s;line-height:1.4}
.oef-item:hover:not(.locked){border-color:#A5B4FF;background:var(--blue-light)}
.oef-item.ai{border-color:var(--green);background:#ECFDF5;color:#065F46;font-weight:500}
.oef-item.geen{border-color:#94A3B8;background:var(--light);color:var(--muted)}
.oef-item.locked{cursor:default}
.oef-legend{display:flex;gap:16px;font-size:12px;color:var(--muted);margin-top:10px}
.leg-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:4px;vertical-align:middle}

/* QUIZ */
.q-text{font-family:'Fraunces',serif;font-size:clamp(18px,2.5vw,24px);font-weight:700;color:var(--ink);line-height:1.35;margin-bottom:24px}
.opt{display:flex;align-items:flex-start;gap:10px;padding:12px 16px;border:1px solid var(--border);border-radius:10px;margin-bottom:8px;cursor:pointer;font-size:14px;color:var(--ink);background:#fff;transition:border .15s,background .15s;line-height:1.5}
.opt:hover:not(.locked){border-color:#A5B4FF;background:var(--blue-light)}
.opt.ok{border-color:var(--green);background:#ECFDF5;color:#065F46}
.opt.no{border-color:var(--red);background:#FEF2F2;color:#991B1B}
.opt.hint{border-color:var(--green);background:#F0FDF4;color:#166534}
.opt.locked{cursor:default}
.opt-k{width:22px;height:22px;border-radius:6px;background:var(--light);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;margin-top:1px;color:var(--muted)}
.fb{padding:12px 16px;border-radius:10px;font-size:13px;line-height:1.6;margin-bottom:12px}
.fb-ok{background:#ECFDF5;border:1px solid #6EE7B7;color:#065F46}
.fb-no{background:#FEF2F2;border:1px solid #FCA5A5;color:#991B1B}
.sc-row{display:flex;justify-content:space-between;align-items:center;margin-top:8px}
.sc-lbl{font-size:12px;color:var(--muted)}

/* OPDRACHT */
.assign-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:20px 24px;margin-bottom:16px}
.assign-card h3{font-size:15px;font-weight:500;color:var(--ink);margin-bottom:12px}
.assign-card li{font-size:14px;color:var(--muted);margin-bottom:7px;line-height:1.6}
.fb-card{background:#FFFBEB;border:1px solid #FDE68A;border-radius:12px;padding:16px 20px;margin-top:16px}
.fb-card-lbl{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
.fb-card p{font-size:14px;color:#78350F;line-height:1.7}
textarea{width:100%;min-height:120px;border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:14px;font-family:'DM Sans',sans-serif;color:var(--ink);background:#fff;resize:vertical;line-height:1.6;margin-bottom:10px}
textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(45,91,227,.1)}
textarea:disabled{background:var(--light);opacity:.7}

/* SAMENVATTING */
.sum-list{list-style:none;padding:0;margin:0 0 16px}
.sum-list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--muted);line-height:1.6;padding:10px 0;border-bottom:1px solid var(--border)}
.sum-list li:last-child{border-bottom:none}
.sum-dot{width:6px;height:6px;border-radius:50%;background:var(--blue);flex-shrink:0;margin-top:8px}

/* COMPLETE */
.comp{text-align:center;padding:48px 24px}
.comp-circle{width:80px;height:80px;border-radius:50%;border:2px solid var(--blue);background:var(--blue-light);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:32px;color:var(--blue)}
.comp-title{font-family:'Fraunces',serif;font-size:clamp(26px,4vw,38px);font-weight:700;color:var(--ink);margin-bottom:8px}
.comp-sub{font-size:15px;color:var(--muted);margin-bottom:8px;line-height:1.65;max-width:420px;margin-left:auto;margin-right:auto}
.comp-quote{font-size:13px;font-style:italic;color:#b0bcdc;margin-bottom:32px;max-width:400px;margin-left:auto;margin-right:auto}
.pill{display:inline-block;background:var(--light);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:13px;color:var(--muted);margin-bottom:24px}

@media(max-width:720px){
  .sidebar{display:none}
  .content{padding:24px 20px 48px}
  .two-col{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="shell">

  <!-- ── SIDEBAR ── -->
  <aside class="sidebar">
    <div class="sidebar-head">
      <a href="index.html" class="sidebar-back">
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 1L3 6l5 5"/></svg>
        Alle modules
      </a>
      <div class="sidebar-mod-label">Module 01</div>
      <div class="sidebar-mod-title">Wat is AI eigenlijk?</div>
    </div>

    <nav class="sidebar-nav">

      <span class="nav-group-label">Introductie</span>
      <div class="nav-group">
        <button class="nav-item active" id="nav-video" onclick="goTo('video')">
          <div class="nav-icon">▶</div>
          Introductievideo
        </button>
      </div>

      <span class="nav-group-label">Lessen</span>
      <div class="nav-group" id="nav-slides-group">
        <!-- Dynamisch gevuld -->
      </div>

      <span class="nav-group-label">Oefening</span>
      <div class="nav-group">
        <button class="nav-item" id="nav-oef" onclick="goTo('oef')">
          <div class="nav-icon">⚡</div>
          AI of geen AI?
        </button>
      </div>

      <span class="nav-group-label">Quiz</span>
      <div class="nav-group">
        <button class="nav-item" id="nav-quiz" onclick="goTo('quiz')">
          <div class="nav-icon">?</div>
          5 kennischeck-vragen
        </button>
      </div>

      <span class="nav-group-label">Afronden</span>
      <div class="nav-group">
        <button class="nav-item" id="nav-assign" onclick="goTo('assign')">
          <div class="nav-icon">✏</div>
          Praktijkopdracht
        </button>
        <button class="nav-item" id="nav-comp" onclick="goTo('comp')">
          <div class="nav-icon">★</div>
          Module afronden
        </button>
      </div>

    </nav>

    <div class="sidebar-footer">
      <div class="progress-label">
        <span>Voortgang</span>
        <span id="prog-pct">0%</span>
      </div>
      <div class="progress-bar">
        <div class="progress-fill" id="prog-fill" style="width:0%"></div>
      </div>
    </div>
  </aside>

  <!-- ── MAIN ── -->
  <div class="main">
    <div class="topbar">
      <div class="topbar-title" id="topbar-title">Introductievideo</div>
      <div class="topbar-right">
        <span class="step-indicator" id="step-indicator"></span>
      </div>
    </div>

    <div class="content">

      <!-- VIDEO -->
      <div class="view active" id="v-video">
        <div class="badge">Module 01 &middot; Introductie</div>
        <h1 class="h1">Wat is AI eigenlijk?</h1>
        <p class="body">Bekijk eerst de introductievideo. Daarna ga je zelf aan de slag met de lessen, oefening en quiz.</p>

        <div class="video-section">
          <div class="video-label">Introductievideo</div>
          <div class="video-container" id="video-container">
            <!--
              VIDEO TOEVOEGEN:
              Optie A — YouTube embed:
              Vervang de placeholder hieronder door:
              <iframe src="https://www.youtube.com/embed/JOUW-VIDEO-ID" allowfullscreen></iframe>

              Optie B — Eigen videobestand:
              <video controls style="width:100%;height:100%;object-fit:cover">
                <source src="jouw-video.mp4" type="video/mp4">
              </video>
            -->
            <div class="video-placeholder">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="20" cy="20" r="18"/>
                <polygon points="16,13 30,20 16,27" fill="currentColor" stroke="none"/>
              </svg>
              <p>Voeg hier je introductievideo toe</p>
              <p><code>YouTube embed of eigen .mp4</code></p>
            </div>
          </div>
        </div>

        <div class="nav-row">
          <span></span>
          <button class="btn-p" onclick="nextSlide()">Begin met les 1 &rarr;</button>
        </div>
      </div>

      <!-- SLIDES -->
      <div class="view" id="v-slides">
        <div class="badge">Module 01 &middot; <span id="snum">les 1/6</span></div>
        <div id="slide-content"></div>
        <div class="nav-row">
          <button class="btn-g" id="sprev" onclick="prevS()">&#8592; Vorige</button>
          <div class="dots" id="sdots"></div>
          <button class="btn-p" id="snext" onclick="nextS()">Volgende &rarr;</button>
        </div>
      </div>

      <!-- OEFENING -->
      <div class="view" id="v-oef">
        <div class="badge">Module 01 &middot; Oefening</div>
        <h1 class="h1">AI of geen AI?</h1>
        <p class="body">Klik op elke toepassing om te zien of er AI in zit. Bedenk eerst zelf — daarna zie je het antwoord en de toelichting.</p>
        <div class="oef-grid" id="oef-grid"></div>
        <div class="oef-legend" id="oef-legend" style="display:none">
          <span><span class="leg-dot" style="background:#059669"></span>Bevat AI</span>
          <span><span class="leg-dot" style="background:#888"></span>Geen AI</span>
        </div>
        <div id="oef-uitleg" style="margin-top:16px"></div>
        <div class="nav-row">
          <button class="btn-g" onclick="goTo('slides')">&#8592; Terug</button>
          <button class="btn-p" id="oef-next" onclick="goTo('quiz');showQ()" style="opacity:.4" disabled>Naar de quiz &rarr;</button>
        </div>
      </div>

      <!-- QUIZ -->
      <div class="view" id="v-quiz">
        <div class="badge">Module 01 &middot; <span id="qnum">Vraag 1/5</span></div>
        <div class="q-text" id="qtext"></div>
        <div id="qopts"></div>
        <div id="qfb"></div>
        <div class="sc-row">
          <span class="sc-lbl" id="qsc">Score: 0/0</span>
          <button class="btn-p" id="qnext" onclick="nextQ()" style="display:none">Volgende &rarr;</button>
        </div>
      </div>

      <!-- OPDRACHT -->
      <div class="view" id="v-assign">
        <div class="badge">Module 01 &middot; Praktijkopdracht</div>
        <h1 class="h1">AI in jouw eigen wereld</h1>
        <p class="body">Theorie wordt pas kennis als je het verbindt met je eigen werkcontext. Neem even de tijd voor deze reflectie.</p>
        <div class="assign-card">
          <h3>Beantwoord de volgende vragen</h3>
          <ul style="padding-left:18px">
            <li>Beschrijf een AI-toepassing die je (bewust of onbewust) gebruikt in je werk of privéleven.</li>
            <li>Wat doet dit systeem waarschijnlijk met jouw data?</li>
            <li>Noem één situatie waarin de output fout of misleidend kon zijn — en waarom dat ertoe doet.</li>
          </ul>
        </div>
        <textarea id="ata" placeholder="Schrijf hier je antwoord..."></textarea>
        <div id="afb"></div>
        <div style="text-align:right">
          <button class="btn-p" id="abtn" onclick="submitA()">Verstuur &amp; ontvang feedback</button>
        </div>
      </div>

      <!-- COMPLETE -->
      <div class="view" id="v-comp">
        <div class="comp">
          <div class="comp-circle">&#10003;</div>
          <div class="comp-title">Module 01 afgerond</div>
          <div class="pill" id="fpill"></div>
          <p class="comp-sub">Je begrijpt nu wat AI is, hoe het verschilt van gewone software, waarom AI menselijk kan lijken zonder het te zijn — en waarom dat ertoe doet in jouw werk.</p>
          <p class="comp-quote">"Hoe beter we begrijpen wat AI is, hoe beter we kunnen bepalen wanneer we AI wel — en juist niet — moeten vertrouwen."</p>
          <a href="index.html" class="btn-g" style="display:inline-block;margin-bottom:12px;text-decoration:none">&#8592; Terug naar alle modules</a>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /main -->
</div><!-- /shell -->

<script>
const SLIDES=[
  {title:'Waarom AI-begrip belangrijk is',body:'Kunstmatige intelligentie is verweven in zoekmachines, sociale media, klantenservice, tekstverwerking, navigatie en besluitvorming. Toch gebruiken veel mensen AI zonder te begrijpen wat het is, hoe het werkt en welke invloed het heeft.',callout:'AI-geletterdheid begint niet bij tools, maar bij begrip. Pas wanneer we begrijpen hoe AI werkt, kunnen we AI bewust, kritisch en verantwoord gebruiken.'},
  {title:'Wat verstaan we onder AI?',body:'AI staat voor Artificial Intelligence — kunstmatige intelligentie. Het gaat om systemen die menselijke taken gedeeltelijk kunnen nabootsen: taal verwerken, patronen herkennen, voorspellingen maken, samenvatten of aanbevelingen doen.',callout:'AI-systemen doen dit niet doordat ze "denken" zoals mensen — maar doordat ze grote hoeveelheden data analyseren en patronen herkennen.'},
  {title:'Traditionele software vs. AI',body:'Traditionele software werkt op vaste regels: ALS dit, DAN dat. De ontwikkelaar schrijft elke stap voor. AI werkt anders: het analyseert data, herkent patronen en voorspelt wat waarschijnlijk het beste antwoord is.',extra:'<div class="two-col"><div class="col-card"><h4>Traditionele software</h4><p>Volgt vaste instructies. Een formulier controleert: is het BSN correct ingevuld? Klopt het format? Altijd hetzelfde resultaat bij dezelfde invoer.</p></div><div class="col-card"><h4>AI-systeem</h4><p>Leert van voorbeelden. Een AI kan documenten samenvatten, patronen herkennen in meldingen of burgers helpen via een chatbot — flexibel, maar ook feilbaar.</p></div></div>'},
  {title:'Waarom AI menselijk lijkt',body:'Mensen kennen snel menselijke eigenschappen toe aan technologie. Wanneer AI vloeiend schrijft, vriendelijk reageert en overtuigend communiceert, ontstaat de indruk dat AI begrijpt, redeneert of bewust keuzes maakt.',callout:'Taalvaardigheid is niet hetzelfde als begrip. AI kan overtuigend schrijven en tegelijkertijd feitelijke fouten maken, bronnen verzinnen of informatie verkeerd interpreteren.'},
  {title:'Hallucinaties: overtuigend fout',body:'Een hallucinatie ontstaat wanneer AI onjuiste informatie genereert, maar deze presenteert alsof het volledig klopt. Dit is geen bewuste leugen — het is een structureel gevolg van hoe AI werkt: voorspellen wat waarschijnlijk volgt, ook als de data ontbreekt.',callout:'AI waarschuwt je niet wanneer het hallucineert. Het klinkt even zelfverzekerd als wanneer het wél klopt. Verificatie is daarom geen optie — het is een vereiste.'},
  {title:'Samenvatting',body:'Je hebt nu de kern van module 1 doorlopen. Dit zijn de vier inzichten die je meeneemt:',extra:'<ul class="sum-list"><li><span class="sum-dot"></span>AI is geen menselijk bewustzijn — het herkent patronen en voorspelt waarschijnlijkheden.</li><li><span class="sum-dot"></span>AI verschilt fundamenteel van traditionele software: het leert, in plaats van regels te volgen.</li><li><span class="sum-dot"></span>AI kan krachtig én feilbaar zijn — ook wanneer het overtuigend klinkt.</li><li><span class="sum-dot"></span>AI-begrip is noodzakelijk om AI verantwoord te gebruiken in je werk.</li></ul>'},
];

const OEFS=[
  {label:'Google Maps',ai:true,uitleg:'AI berekent routes op basis van realtime verkeersdata en voorspelt reistijden.'},
  {label:'TikTok feed',ai:true,uitleg:'AI bepaalt wat je ziet op basis van kijkgedrag, interacties en vergelijkbare gebruikers.'},
  {label:'Spamfilter',ai:true,uitleg:'AI herkent patronen in e-mails om spam te onderscheiden van reguliere berichten.'},
  {label:'Chatbot klantenservice',ai:true,uitleg:'AI verwerkt tekst en genereert antwoorden op basis van trainingsdata en context.'},
  {label:'Rekenmachine',ai:false,uitleg:'Geen AI — een rekenmachine volgt vaste wiskundige regels zonder te leren of te voorspellen.'},
  {label:'Netflix aanbevelingen',ai:true,uitleg:'AI analyseert kijkgedrag en vergelijkt dit met miljoenen andere gebruikers om aanbevelingen te doen.'},
  {label:'Vertaalsoftware',ai:true,uitleg:'Moderne vertaaltools zoals DeepL gebruiken AI om context en betekenis te vertalen, niet alleen woorden.'},
  {label:'PDF-formulier',ai:false,uitleg:'Geen AI — een standaard formulier controleert vaste regels, zoals verplichte velden of formats.'},
];

const QS=[
  {q:'Hoe werkt een AI-systeem fundamenteel anders dan traditionele software?',opts:['Het is sneller en nauwkeuriger','Het leert patronen uit data in plaats van vaste regels te volgen','Het heeft altijd een internetverbinding nodig','Het maakt geen fouten'],c:1,expl:'Traditionele software volgt geprogrammeerde regels. AI leert van voorbeelden en voorspelt op basis van patronen.'},
  {q:'Wat is de kernboodschap van module 1?',opts:['AI denkt sneller dan mensen','AI herkent patronen en voorspelt waarschijnlijkheden — het denkt niet zoals mensen','AI is altijd betrouwbaarder dan menselijk oordeel','AI begrijpt taal beter dan mensen'],c:1,expl:'AI simuleert begrip door patronen te herkennen in data. Er is geen sprake van echt denken of bewustzijn.'},
  {q:'Wat is een AI-hallucinatie?',opts:['Een visuele fout in een AI-interface','Een situatie waarin AI zelfverzekerd onjuiste informatie presenteert','Een bewuste leugen van een AI-systeem','Een technische storing waardoor AI niet reageert'],c:1,expl:'Hallucinaties zijn structureel: AI voorspelt wat waarschijnlijk volgt, ook als de feitelijke basis ontbreekt.'},
  {q:'Waarom lijkt AI soms menselijk, terwijl het dat niet is?',opts:['Omdat AI een bewustzijn heeft ontwikkeld','Omdat vloeiende taal en vriendelijke toon de indruk wekken van begrip en intentie','Omdat AI altijd correcte informatie geeft','Omdat AI getraind is op menselijke emoties'],c:1,expl:'Mensen schrijven snel menselijke eigenschappen toe aan systemen die vloeiend communiceren. Maar taalvaardigheid is niet hetzelfde als begrip.'},
  {q:'Welke van deze toepassingen bevat GEEN AI?',opts:['Een chatbot op een overheidswebsite','Netflix-aanbevelingen','Een rekenmachine','Een spamfilter'],c:2,expl:'Een rekenmachine volgt vaste wiskundige regels. Er is geen leren, patroonherkenning of voorspelling — dus geen AI.'},
];

// ── STATE ──
let currentView='video', si=0, qi=0, score=0, picked=null, oefClicked=0;
const TOTAL_STEPS = 1 + SLIDES.length + 1 + 1 + 1 + 1; // video + slides + oef + quiz + assign + comp
let completedSteps = new Set();

// ── INIT SIDEBAR SLIDES ──
function initSidebar(){
  const g=document.getElementById('nav-slides-group');
  g.innerHTML=SLIDES.map((s,i)=>`
    <button class="nav-item" id="nav-slide-${i}" onclick="goToSlide(${i})">
      <div class="nav-icon">${i+1}</div>
      ${s.title}
    </button>`).join('');
}

// ── NAVIGATION ──
const VIEWS=['video','slides','oef','quiz','assign','comp'];

function show(v){
  VIEWS.forEach(n=>document.getElementById('v-'+n).classList.remove('active'));
  document.getElementById('v-'+v).classList.add('active');
  currentView=v;
  updateSidebar();
  updateTopbar();
  updateProgress();
}

function goTo(v){
  if(v==='slides'){renderSlide();}
  if(v==='quiz'&&qi===0&&!document.getElementById('qtext').textContent){showQ();}
  show(v);
}

function goToSlide(i){si=i;renderSlide();show('slides');}

function updateSidebar(){
  // Clear all active
  document.querySelectorAll('.nav-item').forEach(el=>el.classList.remove('active'));

  if(currentView==='video') document.getElementById('nav-video').classList.add('active');
  else if(currentView==='slides') document.getElementById('nav-slide-'+si)?.classList.add('active');
  else if(currentView==='oef') document.getElementById('nav-oef').classList.add('active');
  else if(currentView==='quiz') document.getElementById('nav-quiz').classList.add('active');
  else if(currentView==='assign') document.getElementById('nav-assign').classList.add('active');
  else if(currentView==='comp') document.getElementById('nav-comp').classList.add('active');

  // Mark done
  if(completedSteps.has('video')) markNavDone('nav-video');
  SLIDES.forEach((_,i)=>{ if(completedSteps.has('slide-'+i)) markNavDone('nav-slide-'+i); });
  if(completedSteps.has('oef')) markNavDone('nav-oef');
  if(completedSteps.has('quiz')) markNavDone('nav-quiz');
  if(completedSteps.has('assign')) markNavDone('nav-assign');
}

function markNavDone(id){
  const el=document.getElementById(id);
  if(el&&!el.classList.contains('active')){el.classList.add('done');}
}

function updateTopbar(){
  const titles={
    video:'Introductievideo',
    slides: si<SLIDES.length ? `Les ${si+1} van ${SLIDES.length} — ${SLIDES[si].title}` : '',
    oef:'Oefening — AI of geen AI?',
    quiz:`Quiz — Vraag ${qi+1} van ${QS.length}`,
    assign:'Praktijkopdracht',
    comp:'Module afgerond'
  };
  document.getElementById('topbar-title').textContent=titles[currentView]||'';
}

function updateProgress(){
  const pct=Math.round(completedSteps.size/TOTAL_STEPS*100);
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('prog-pct').textContent=pct+'%';
}

// ── SLIDES ──
function renderSlide(){
  const s=SLIDES[si];
  document.getElementById('slide-content').innerHTML=
    '<h1 class="h1">'+s.title+'</h1>'+
    '<p class="body">'+s.body+'</p>'+
    (s.callout?'<div class="callout">'+s.callout+'</div>':'')+
    (s.extra||'');
  document.getElementById('snum').textContent='les '+(si+1)+'/'+SLIDES.length;
  document.getElementById('sprev').disabled=si===0;
  document.getElementById('snext').textContent=si===SLIDES.length-1?'Naar de oefening \u2192':'Volgende \u2192';
  const d=document.getElementById('sdots');
  d.innerHTML=SLIDES.map((_,i)=>'<div class="dot'+(i===si?' cur':i<si?' past':' fut')+'" style="width:'+(i===si?18:6)+'px"></div>').join('');
  completedSteps.add('slide-'+si);
  updateSidebar();updateTopbar();updateProgress();
}

function prevS(){if(si>0){si--;renderSlide();}}
function nextS(){
  completedSteps.add('slide-'+si);
  if(si<SLIDES.length-1){si++;renderSlide();}
  else{completedSteps.add('slides-done');show('oef');renderOef();}
}
function nextSlide(){completedSteps.add('video');show('slides');si=0;renderSlide();}

// ── OEFENING ──
function renderOef(){
  document.getElementById('oef-grid').innerHTML=OEFS.map((o,i)=>
    '<div class="oef-item" id="oi'+i+'" onclick="pickOef('+i+')">'+o.label+'</div>'
  ).join('');
}
function pickOef(i){
  const el=document.getElementById('oi'+i),o=OEFS[i];
  if(el.classList.contains('locked'))return;
  el.classList.add('locked',o.ai?'ai':'geen');
  oefClicked++;
  const u=document.getElementById('oef-uitleg');
  u.innerHTML='<div class="fb '+(o.ai?'fb-ok':'fb-no')+'"><strong>'+o.label+'</strong> — '+(o.ai?'Bevat AI. ':'Geen AI. ')+o.uitleg+'</div>'+u.innerHTML;
  if(oefClicked===OEFS.length){
    document.getElementById('oef-legend').style.display='flex';
    const nb=document.getElementById('oef-next');nb.disabled=false;nb.style.opacity='1';
    completedSteps.add('oef');updateProgress();updateSidebar();
  }
}

// ── QUIZ ──
function showQ(){
  const q=QS[qi];picked=null;
  document.getElementById('qnum').textContent='Vraag '+(qi+1)+'/'+QS.length;
  document.getElementById('qtext').textContent=q.q;
  document.getElementById('qfb').innerHTML='';
  document.getElementById('qnext').style.display='none';
  document.getElementById('qsc').textContent='Score: '+score+'/'+qi;
  document.getElementById('qopts').innerHTML=q.opts.map((o,i)=>
    '<div class="opt" id="qo'+i+'" onclick="pickQ('+i+')"><div class="opt-k">'+['A','B','C','D'][i]+'</div>'+o+'</div>'
  ).join('');
  updateTopbar();
}
function pickQ(i){
  if(picked!==null)return;
  picked=i;const q=QS[qi],cor=i===q.c;
  if(cor)score++;
  document.querySelectorAll('.opt').forEach((el,idx)=>{
    el.classList.add('locked');
    if(idx===q.c)el.classList.add(i===q.c?'ok':'hint');
    if(idx===i&&!cor)el.classList.add('no');
  });
  document.getElementById('qfb').innerHTML='<div class="fb '+(cor?'fb-ok':'fb-no')+'">'+(cor?'\u2713 Correct. ':'\u2717 Niet correct. ')+q.expl+'</div>';
  document.getElementById('qnext').style.display='inline-block';
  document.getElementById('qsc').textContent='Score: '+score+'/'+(qi+1);
}
function nextQ(){
  if(qi<QS.length-1){qi++;showQ();}
  else{completedSteps.add('quiz');show('assign');updateProgress();}
}

// ── OPDRACHT ──
async function submitA(){
  const ta=document.getElementById('ata');
  if(!ta.value.trim())return;
  ta.disabled=true;
  const btn=document.getElementById('abtn');
  btn.textContent='Feedback laden\u2026';btn.disabled=true;
  try{
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json','anthropic-version':'2023-06-01','x-api-key':'JOUW_API_KEY_HIER'},
      body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:200,
        system:'Je bent een deskundige coach voor overheidsmedewerkers in AI-geletterdheid. Geef korte, bemoedigende, concrete feedback (max 80 woorden, geen bullets). Warm maar direct. Taal: Nederlands.',
        messages:[{role:'user',content:'Module: Wat is AI eigenlijk?\nOpdracht: Beschrijf een AI-toepassing, wat het systeem met data doet, en een situatie waarin output fout of misleidend kon zijn.\nAntwoord: '+ta.value}]})
    });
    const d=await r.json();
    showFb(d.content?.[0]?.text||fallback());
  }catch{showFb(fallback());}
}
function fallback(){return'Goed werk. Je hebt de kern geraakt: een toepassing benoemen, nadenken over data en een reëel risico formuleren — dat is precies wat kritisch AI-gebruik in de overheid vraagt.';}
function showFb(txt){
  document.getElementById('afb').innerHTML='<div class="fb-card"><div class="fb-card-lbl">Coach-feedback</div><p>'+txt+'</p></div>';
  const btn=document.getElementById('abtn');
  btn.textContent='Module afronden \u2192';btn.disabled=false;
  btn.onclick=()=>{
    completedSteps.add('assign');completedSteps.add('comp');
    document.getElementById('fpill').textContent=score+' van '+QS.length+' quizvragen goed';
    show('comp');updateProgress();
  };
}

// ── BOOT ──
initSidebar();
</script>
</body>
</html>
